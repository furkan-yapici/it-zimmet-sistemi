# ---- Veritabanı (PostgreSQL) ----
POSTGRES_USER=zimmet_user
POSTGRES_PASSWORD=zimmet_pass
POSTGRES_DB=zimmet_db
POSTGRES_PORT=5432
# Backend'in Prisma ile bağlanacağı tam bağlantı adresi (docker-compose içindeki db servis adını kullanır)
DATABASE_URL=postgresql://zimmet_user:zimmet_pass@db:5432/zimmet_db?schema=public

# ---- Backend ----
PORT=3001
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=1d

# İlk çalıştırmada seed ile oluşturulacak admin kullanıcısı
ADMIN_EMAIL=admin@zimmet.local
ADMIN_PASSWORD=Admin123!

# ---- Frontend ----
FRONTEND_PORT=5173
# Frontend'in backend API'ye erişeceği adres (tarayıcıdan erişilebilir olmalı)
VITE_API_URL=http://localhost:3001
